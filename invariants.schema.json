{
  "title": "CodeForge2 Invariants Registry",
  "description": "Schema cho invariants.yaml. Single source of truth = INVARIANTS.md. Dùng với ajv (draft-07).",
  "type": "object",
  "required": ["version", "invariants"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": ["string", "number"],
      "description": "Version cua registry, khop INVARIANTS.md."
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/invariant" }
    }
  },
  "definitions": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "enforcement",
        "violation_class",
        "test",
        "phase",
        "severity",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{3}$",
          "description": "Prefix domain + so 3 chu so, vi du VR-001."
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "violation_class": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "pattern": "^tests/invariants/[a-z0-9-]+/[a-z]{2}-[0-9]{3}\\.spec\\.ts$"
        },
        "phase": {
          "type": ["number", "string"],
          "enum": [0, 1, 1.5, 2, 3, 4, 5, 6, 7, 8, "0", "1", "1.5", "2", "3", "4", "5", "6", "7", "8"]
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM"]
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "DEPRECATED"]
        },
        "deprecation_reason": {
          "type": "string",
          "description": "Bat buoc khi status = DEPRECATED (kiem tra o CI)."
        },
        "deprecated_at": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "DEPRECATED" } } },
          "then": { "required": ["deprecation_reason", "deprecated_at"] }
        }
      ]
    }
  }
}
