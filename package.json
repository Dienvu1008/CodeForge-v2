{
  "name": "codeforge2",
  "version": "0.0.0",
  "private": true,
  "description": "Ollama Coding Agent — deterministic runtime kernel (Phase 0 executable architecture contract).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run tests/invariants",
    "test:workspace-vectors": "vitest run tests/workspace",
    "test:cross-platform": "vitest run tests/cross-platform",
    "test:adversarial": "vitest run tests/adversarial",
    "test:contracts": "vitest run tests/contracts",
    "lint": "eslint .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "gen:vectors": "npm run typecheck && node scripts/gen-vector-expected.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0"
  }
}
