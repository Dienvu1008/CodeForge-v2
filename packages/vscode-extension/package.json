{
  "name": "codeforge-observability",
  "displayName": "CodeForge",
  "description": "Observe and control a CodeForge runtime from VS Code.",
  "version": "0.1.0",
  "publisher": "codeforge",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "codeforge", "title": "CodeForge", "icon": "$(server-process)" }
      ]
    },
    "views": {
      "codeforge": [
        { "id": "codeforge.sessions",  "name": "Sessions" },
        { "id": "codeforge.taskGraph", "name": "Task Graph" },
        { "id": "codeforge.changes",   "name": "Changes" },
        { "id": "codeforge.governance","name": "Governance" }
      ]
    },
    "commands": [
      { "command": "codeforge.connect",    "title": "CodeForge: Connect to Runtime" },
      { "command": "codeforge.startRuntime","title": "CodeForge: Start Runtime Here", "icon": "$(play)" },
      { "command": "codeforge.stopRuntime", "title": "CodeForge: Stop Runtime", "icon": "$(debug-stop)" },
      { "command": "codeforge.goals",       "title": "CodeForge: Goals", "icon": "$(comment-discussion)" },
      { "command": "codeforge.pickModel",   "title": "CodeForge: Select Model" },
      { "command": "codeforge.dashboard",  "title": "CodeForge: Open Dashboard", "icon": "$(browser)" },
      { "command": "codeforge.refresh",    "title": "CodeForge: Refresh", "icon": "$(refresh)" },
      { "command": "codeforge.attachSession", "title": "CodeForge: Attach to Session" },
      { "command": "codeforge.viewDiff", "title": "CodeForge: View Change Diff" },
      { "command": "codeforge.submitGoal", "title": "CodeForge: Submit Goal", "icon": "$(add)" },
      { "command": "codeforge.pause",      "title": "CodeForge: Pause Session", "icon": "$(debug-pause)" },
      { "command": "codeforge.resume",     "title": "CodeForge: Resume Session", "icon": "$(debug-continue)" },
      { "command": "codeforge.cancel",     "title": "CodeForge: Cancel Session", "icon": "$(debug-stop)" },
      { "command": "codeforge.checkpoint", "title": "CodeForge: Checkpoint", "icon": "$(save)" }
    ],
    "menus": {
      "view/title": [
        { "command": "codeforge.goals",      "when": "view == codeforge.sessions",  "group": "navigation@1" },
        { "command": "codeforge.startRuntime","when": "view == codeforge.sessions", "group": "navigation@2" },
        { "command": "codeforge.refresh",   "when": "view == codeforge.sessions",  "group": "navigation@3" },
        { "command": "codeforge.dashboard", "when": "view == codeforge.sessions",  "group": "navigation@4" },
        { "command": "codeforge.pause",     "when": "view == codeforge.taskGraph", "group": "navigation@1" },
        { "command": "codeforge.resume",    "when": "view == codeforge.taskGraph", "group": "navigation@2" },
        { "command": "codeforge.cancel",    "when": "view == codeforge.taskGraph", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "codeforge.attachSession", "when": "view == codeforge.sessions && viewItem == session", "group": "inline" }
      ]
    },
    "configuration": {
      "title": "CodeForge",
      "properties": {
        "codeforge.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a built runtime-cli.js. Required for 'Start Runtime Here' when the extension is installed as a .vsix (in a dev checkout the opened workspace is used)."
        },
        "codeforge.nodePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Node.js binary used to run the runtime. Leave empty to use 'node' from PATH. Must be the SYSTEM Node the runtime's native modules (better-sqlite3) were built for — do NOT point at VS Code itself."
        },
        "codeforge.model": {
          "type": "string",
          "default": "qwen2.5-coder:latest",
          "description": "Default model id the runtime runs when started here."
        },
        "codeforge.port": {
          "type": "number",
          "default": 9500,
          "description": "HTTP port the runtime's observability server listens on."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "@codeforge/agent-core": "file:../agent-core"
  },
  "dependencies": {}
}
